{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/gitIntegration/schedules/1.0.0/schema.json",
  "schedules": [
    {
      "enabled": true,
      "jobType": "Execute",
      "configuration": {
        "type": "Weekly",
        "startDateTime": "2025-12-17T00:00:00",
        "endDateTime": "2029-12-17T23:59:00",
        "localTimeZoneId": "Romance Standard Time",
        "times": [
          "01:36"
        ],
        "weekdays": [
          "Monday",
          "Friday"
        ]
      }
    },
    {
      "enabled": true,
      "jobType": "Execute",
      "configuration": {
        "type": "Cron",
        "startDateTime": "2026-01-06T03:11:00",
        "endDateTime": "2027-01-07T09:11:00",
        "localTimeZoneId": "GTB Standard Time",
        "interval": 90
      }
    }
  ]
}