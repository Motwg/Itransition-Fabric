table FactTaxiDaily
	lineageTag: cf3abd57-b0c3-40a9-9bce-1f41ce02e976
	sourceLineageTag: [Gold].[FactTaxiDaily]

	measure 'Avg. Trips per Day' =
			
			AVERAGEX (
			    VALUES ( 'DimDate'[date] ),
			    CALCULATE ( SUM ( FactTaxiDaily[count_trips] ) )
			)
		lineageTag: 0a1c7e3b-a959-464a-a3d9-2b391733d2ee

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure sum_fares_eur =
			SUMX(
			    'FactTaxiDaily',
			    'FactTaxiDaily'[sum_fares] * RELATED('DimFX'[fx])
			)
		lineageTag: 27106fa3-7a87-41e7-b4f2-fc8a801989a7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

